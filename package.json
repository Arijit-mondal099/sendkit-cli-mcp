{
  "name": "sendkit-cli-mcp-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "cli:dev": "bun run packages/cli/src/index.ts",
    "stdio-mcp:dev": "bun run packages/stdio-mcp/src/index.ts",
    "http-mcp:dev": "bun run apps/http-mcp/src/index.ts",
    "build:core": "bun run --filter @sendkit-cli-mcp/core build",
    "build:cli": "bun run --filter @sendkit-cli-mcp/cli build",
    "build:local-mcp": "bun run --filter @sendkit-cli-mcp/stdio-mcp build",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}
